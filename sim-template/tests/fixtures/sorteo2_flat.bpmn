    <bpmn:userTask id="T_SubirOp" name="Subir la base al sistema con su nombre y sus grupos"/>
    <bpmn:serviceTask id="T_ValidarOp" name="Validar y cargar los participantes sin repetir usuarios"/>
    <bpmn:exclusiveGateway id="G_SinIdOp" name="¿Hay personas sin id?"/>
