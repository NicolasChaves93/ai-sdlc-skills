    <bpmn:startEvent id="Start_Evento" name="Evento programado"/>
    <bpmn:manualTask id="T_Entregar" name="Entregar base de participantes por grupos"/>
    <bpmn:userTask id="T_Subir" name="Subir la base al sistema con su nombre y sus grupos"/>
    <bpmn:serviceTask id="T_Validar" name="Validar y cargar los participantes sin repetir usuarios"/>
    <bpmn:exclusiveGateway id="G_SinId" name="¿Hay personas sin id?"/>
    <bpmn:serviceTask id="T_AsignarId" name="Asignar un id único a quien no traía y dejar la nota"/>
    <bpmn:serviceTask id="T_Informe" name="Generar el informe de la carga: cargados y rechazados con su motivo"/>
    <bpmn:exclusiveGateway id="G_Cargo" name="¿Se cargó al menos un participante?"/>
    <bpmn:serviceTask id="T_InfNinguno" name="Informar al cliente que no se cargó ninguno y el motivo de cada uno"/>
    <bpmn:exclusiveGateway id="G_Rech" name="¿Hubo participantes rechazados?"/>
    <bpmn:serviceTask id="T_InfRech" name="Informar al cliente quiénes se rechazaron y el motivo"/>
    <bpmn:exclusiveGateway id="G_Vuelta"/>
    <bpmn:exclusiveGateway id="G_Oper" name="¿Operar sobre los participantes?"/>
