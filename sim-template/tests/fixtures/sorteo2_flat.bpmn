    <bpmn:exclusiveGateway id="G_RechOp" name="¿Hubo participantes rechazados?"/>
    <bpmn:serviceTask id="T_InfRechOp" name="Informar al cliente quiénes se rechazaron y el motivo"/>
    <bpmn:serviceTask id="T_ListarP" name="Listar los participantes por base y grupo"/>
    <bpmn:serviceTask id="T_ListarG" name="Listar los ganadores del evento"/>
    <bpmn:userTask id="T_Elegir" name="Elegir qué eliminar: participantes por id o un grupo completo"/>
    <bpmn:serviceTask id="T_VerElim" name="Verificar si alguno es ganador"/>
    <bpmn:exclusiveGateway id="G_Gan" name="¿Alguno es ganador?"/>
    <bpmn:userTask id="T_Autorizar" name="Pedir autorización: eliminar todo o conservar a los ganadores"/>
    <bpmn:exclusiveGateway id="G_Aut" name="¿Qué se autoriza?"/>
    <bpmn:serviceTask id="T_ElimTodo" name="Anular los premios de los ganadores elegidos y eliminar a todos"/>
    <bpmn:serviceTask id="T_ElimResto" name="Eliminar solo a los que no son ganadores y avisar a quiénes se conservó"/>
    <bpmn:serviceTask id="T_Elim" name="Eliminar los participantes"/>
    <bpmn:userTask id="T_Anular" name="Elegir al ganador cuyo premio se anula"/>
    <bpmn:serviceTask id="T_RegAnul" name="Anular el premio y registrarlo; vuelve a ser participante"/>
    <bpmn:userTask id="T_Confirmar" name="Pedir confirmación del reinicio del sorteo"/>
    <bpmn:exclusiveGateway id="G_Conf" name="¿Confirmó?"/>
    <bpmn:exclusiveGateway id="G_Limpia" name="¿Qué se limpia?"/>
    <bpmn:serviceTask id="T_Reiniciar" name="Limpiar todo el sorteo: base, sorteados y ganadores"/>
    <bpmn:serviceTask id="T_ReiniciarBase" name="Limpiar solo la base y conservar los ganadores"/>
    <bpmn:serviceTask id="T_Corte" name="Generar el reporte de resultados con corte a esta hora"/>
    <bpmn:exclusiveGateway id="G_Unir"/>
    <bpmn:exclusiveGateway id="G_Mas" name="¿Otra operación?"/>
    <bpmn:userTask id="T_Config" name="Configurar el sorteo: grupo, base y cuántos ganadores reales"/>
    <bpmn:exclusiveGateway id="G_Hab" name="¿Habilitar de nuevo a sorteados que no fueron ganador real?"/>
    <bpmn:userTask id="T_Habilitar" name="Marcar a los sorteados que no fueron ganador real y se habilitan en este sorteo"/>
    <bpmn:exclusiveGateway id="G_UneHab"/>
    <bpmn:exclusiveGateway id="G_Alcanza" name="¿Hay suficientes participantes elegibles?"/>
    <bpmn:userTask id="T_Ajustar" name="Ajustar la configuración: número de ganadores, base o grupo"/>
    <bpmn:serviceTask id="T_Seleccionar" name="Sortear a la siguiente persona sin repetir a las ya sorteadas"/>
    <bpmn:userTask id="T_Mostrar" name="Mostrar a la persona sorteada en la pantalla del evento"/>
    <bpmn:userTask id="T_Verificar" name="Verificar si la persona sorteada es ganador real"/>
    <bpmn:exclusiveGateway id="G_Real" name="¿Es ganador real?"/>
    <bpmn:serviceTask id="T_RegReal" name="Registrar al ganador real: orden en el grupo, orden general, hora y nota"/>
    <bpmn:serviceTask id="T_RegNoReal" name="Registrar que no es ganador real: orden, hora y motivo"/>
