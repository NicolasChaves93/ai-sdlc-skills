<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Sorteo" targetNamespace="http://colombiancode.co/plataforma-v2/sorteo">
  <bpmn:process id="Process_Evento" name="Evento de sorteos (Plataforma de Juegos v2)" isExecutable="false">
    <bpmn:startEvent id="Start_Evento" name="Evento programado"/>
    <bpmn:subProcess id="SP_Prep" name="1. Preparación del evento">
      <bpmn:startEvent id="Start_Prep"/>
      <bpmn:manualTask id="T_Entregar" name="Entregar base de participantes por grupos"/>
      <bpmn:subProcess id="SP_Cargar" name="Cargar participantes">
        <bpmn:startEvent id="Start_Car"/>
        <bpmn:userTask id="T_Subir" name="Subir la base al sistema con su nombre y sus grupos"/>
        <bpmn:serviceTask id="T_Validar" name="Validar y cargar los participantes sin repetir usuarios"/>
        <bpmn:exclusiveGateway id="G_SinId" name="¿Hay personas sin id?"/>
        <bpmn:serviceTask id="T_AsignarId" name="Asignar un id único a quien no traía y dejar la nota"/>
        <bpmn:serviceTask id="T_Informe" name="Generar el informe de la carga: cargados y rechazados con su motivo"/>
        <bpmn:endEvent id="End_Car"/>
        <bpmn:sequenceFlow id="F_car1" sourceRef="Start_Car" targetRef="T_Subir"/>
        <bpmn:sequenceFlow id="F_car2" sourceRef="T_Subir" targetRef="T_Validar"/>
        <bpmn:sequenceFlow id="F_car3" sourceRef="T_Validar" targetRef="G_SinId"/>
        <bpmn:sequenceFlow id="F_sinid_si" name="Sí" sourceRef="G_SinId" targetRef="T_AsignarId"/>
        <bpmn:sequenceFlow id="F_sinid_no" name="No" sourceRef="G_SinId" targetRef="T_Informe"/>
        <bpmn:sequenceFlow id="F_car3b" sourceRef="T_AsignarId" targetRef="T_Informe"/>
        <bpmn:sequenceFlow id="F_car4" sourceRef="T_Informe" targetRef="End_Car"/>
      </bpmn:subProcess>
      <bpmn:exclusiveGateway id="G_Cargo" name="¿Se cargó al menos un participante?"/>
      <bpmn:serviceTask id="T_InfNinguno" name="Informar al cliente que no se cargó ninguno y el motivo de cada uno"/>
      <bpmn:exclusiveGateway id="G_Rech" name="¿Hubo participantes rechazados?"/>
      <bpmn:serviceTask id="T_InfRech" name="Informar al cliente quiénes se rechazaron y el motivo"/>
      <bpmn:endEvent id="End_Prep"/>
      <bpmn:sequenceFlow id="F_s1" sourceRef="Start_Prep" targetRef="T_Entregar"/>
      <bpmn:sequenceFlow id="F_s2" sourceRef="T_Entregar" targetRef="SP_Cargar"/>
      <bpmn:sequenceFlow id="F_s3" sourceRef="SP_Cargar" targetRef="G_Cargo"/>
      <bpmn:sequenceFlow id="F_cargo_si" name="Sí" sourceRef="G_Cargo" targetRef="G_Rech"/>
      <bpmn:sequenceFlow id="F_cargo_no" name="No" sourceRef="G_Cargo" targetRef="T_InfNinguno"/>
      <bpmn:sequenceFlow id="F_s5" sourceRef="T_InfNinguno" targetRef="T_Entregar"/>
      <bpmn:sequenceFlow id="F_rech_si" name="Sí" sourceRef="G_Rech" targetRef="T_InfRech"/>
      <bpmn:sequenceFlow id="F_rech_no" name="No" sourceRef="G_Rech" targetRef="End_Prep"/>
      <bpmn:sequenceFlow id="F_s6" sourceRef="T_InfRech" targetRef="End_Prep"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="SP_Sorteos" name="2. Sorteos del evento">
      <bpmn:startEvent id="Start_Sorteos"/>
      <bpmn:exclusiveGateway id="G_Vuelta"/>
      <bpmn:exclusiveGateway id="G_Oper" name="¿Operar sobre los participantes?"/>
      <bpmn:subProcess id="SP_Operar" name="Operación de participantes">
        <bpmn:startEvent id="Start_Oper"/>
        <bpmn:exclusiveGateway id="G_Entra"/>
        <bpmn:exclusiveGateway id="G_Op" name="¿Qué operación?"/>
        <bpmn:subProcess id="SP_CargarOp" name="Cargar participantes">
          <bpmn:startEvent id="Start_CarOp"/>
          <bpmn:userTask id="T_SubirOp" name="Subir la base al sistema con su nombre y sus grupos"/>
          <bpmn:serviceTask id="T_ValidarOp" name="Validar y cargar los participantes sin repetir usuarios"/>
          <bpmn:exclusiveGateway id="G_SinIdOp" name="¿Hay personas sin id?"/>
          <bpmn:serviceTask id="T_AsignarIdOp" name="Asignar un id único a quien no traía y dejar la nota"/>
          <bpmn:serviceTask id="T_InformeOp" name="Generar el informe de la carga: cargados y rechazados con su motivo"/>
          <bpmn:exclusiveGateway id="G_RechOp" name="¿Hubo participantes rechazados?"/>
          <bpmn:serviceTask id="T_InfRechOp" name="Informar al cliente quiénes se rechazaron y el motivo"/>
          <bpmn:endEvent id="End_CarOp"/>
          <bpmn:sequenceFlow id="F_co1" sourceRef="Start_CarOp" targetRef="T_SubirOp"/>
          <bpmn:sequenceFlow id="F_co2" sourceRef="T_SubirOp" targetRef="T_ValidarOp"/>
          <bpmn:sequenceFlow id="F_co3" sourceRef="T_ValidarOp" targetRef="G_SinIdOp"/>
          <bpmn:sequenceFlow id="F_sinidop_si" name="Sí" sourceRef="G_SinIdOp" targetRef="T_AsignarIdOp"/>
          <bpmn:sequenceFlow id="F_sinidop_no" name="No" sourceRef="G_SinIdOp" targetRef="T_InformeOp"/>
          <bpmn:sequenceFlow id="F_co3b" sourceRef="T_AsignarIdOp" targetRef="T_InformeOp"/>
          <bpmn:sequenceFlow id="F_co4" sourceRef="T_InformeOp" targetRef="G_RechOp"/>
          <bpmn:sequenceFlow id="F_rechop_si" name="Sí" sourceRef="G_RechOp" targetRef="T_InfRechOp"/>
          <bpmn:sequenceFlow id="F_rechop_no" name="No" sourceRef="G_RechOp" targetRef="End_CarOp"/>
          <bpmn:sequenceFlow id="F_o2" sourceRef="T_InfRechOp" targetRef="End_CarOp"/>
        </bpmn:subProcess>
        <bpmn:serviceTask id="T_ListarP" name="Listar los participantes por base y grupo"/>
        <bpmn:serviceTask id="T_ListarG" name="Listar los ganadores del evento"/>
        <bpmn:subProcess id="SP_Eliminar" name="Eliminar participantes">
          <bpmn:startEvent id="Start_Elim"/>
          <bpmn:userTask id="T_Elegir" name="Elegir qué eliminar: participantes por id o un grupo completo"/>
          <bpmn:serviceTask id="T_VerElim" name="Verificar si alguno es ganador"/>
          <bpmn:exclusiveGateway id="G_Gan" name="¿Alguno es ganador?"/>
          <bpmn:userTask id="T_Autorizar" name="Pedir autorización: eliminar todo o conservar a los ganadores"/>
          <bpmn:exclusiveGateway id="G_Aut" name="¿Qué se autoriza?"/>
          <bpmn:serviceTask id="T_ElimTodo" name="Anular los premios de los ganadores elegidos y eliminar a todos"/>
          <bpmn:serviceTask id="T_ElimResto" name="Eliminar solo a los que no son ganadores y avisar a quiénes se conservó"/>
          <bpmn:serviceTask id="T_Elim" name="Eliminar los participantes"/>
          <bpmn:endEvent id="End_Elim"/>
          <bpmn:sequenceFlow id="F_o5a" sourceRef="Start_Elim" targetRef="T_Elegir"/>
          <bpmn:sequenceFlow id="F_o5" sourceRef="T_Elegir" targetRef="T_VerElim"/>
          <bpmn:sequenceFlow id="F_o6" sourceRef="T_VerElim" targetRef="G_Gan"/>
          <bpmn:sequenceFlow id="F_gan_si" name="Sí" sourceRef="G_Gan" targetRef="T_Autorizar"/>
          <bpmn:sequenceFlow id="F_gan_no" name="No" sourceRef="G_Gan" targetRef="T_Elim"/>
          <bpmn:sequenceFlow id="F_o7" sourceRef="T_Autorizar" targetRef="G_Aut"/>
          <bpmn:sequenceFlow id="F_aut_todo" name="Todo" sourceRef="G_Aut" targetRef="T_ElimTodo"/>
          <bpmn:sequenceFlow id="F_aut_resto" name="Conservar" sourceRef="G_Aut" targetRef="T_ElimResto"/>
          <bpmn:sequenceFlow id="F_o7a" sourceRef="T_ElimTodo" targetRef="End_Elim"/>
          <bpmn:sequenceFlow id="F_o7b" sourceRef="T_ElimResto" targetRef="End_Elim"/>
          <bpmn:sequenceFlow id="F_o8" sourceRef="T_Elim" targetRef="End_Elim"/>
        </bpmn:subProcess>
        <bpmn:userTask id="T_Anular" name="Elegir al ganador cuyo premio se anula"/>
        <bpmn:serviceTask id="T_RegAnul" name="Anular el premio y registrarlo; vuelve a ser participante"/>
        <bpmn:subProcess id="SP_Reiniciar" name="Reiniciar sorteo">
          <bpmn:startEvent id="Start_Reinic"/>
          <bpmn:userTask id="T_Confirmar" name="Pedir confirmación del reinicio del sorteo"/>
          <bpmn:exclusiveGateway id="G_Conf" name="¿Confirmó?"/>
          <bpmn:exclusiveGateway id="G_Limpia" name="¿Qué se limpia?"/>
          <bpmn:serviceTask id="T_Reiniciar" name="Limpiar todo el sorteo: base, sorteados y ganadores"/>
          <bpmn:serviceTask id="T_ReiniciarBase" name="Limpiar solo la base y conservar los ganadores"/>
          <bpmn:endEvent id="End_Reinic"/>
          <bpmn:sequenceFlow id="F_o10a" sourceRef="Start_Reinic" targetRef="T_Confirmar"/>
          <bpmn:sequenceFlow id="F_o11" sourceRef="T_Confirmar" targetRef="G_Conf"/>
          <bpmn:sequenceFlow id="F_conf_si" name="Sí" sourceRef="G_Conf" targetRef="G_Limpia"/>
          <bpmn:sequenceFlow id="F_limp_todo" name="Todo" sourceRef="G_Limpia" targetRef="T_Reiniciar"/>
          <bpmn:sequenceFlow id="F_limp_base" name="Solo la base" sourceRef="G_Limpia" targetRef="T_ReiniciarBase"/>
          <bpmn:sequenceFlow id="F_o12b" sourceRef="T_ReiniciarBase" targetRef="End_Reinic"/>
          <bpmn:sequenceFlow id="F_conf_no" name="No" sourceRef="G_Conf" targetRef="End_Reinic"/>
          <bpmn:sequenceFlow id="F_o12" sourceRef="T_Reiniciar" targetRef="End_Reinic"/>
        </bpmn:subProcess>
        <bpmn:serviceTask id="T_Corte" name="Generar el reporte de resultados con corte a esta hora"/>
        <bpmn:exclusiveGateway id="G_Unir"/>
        <bpmn:exclusiveGateway id="G_Mas" name="¿Otra operación?"/>
        <bpmn:endEvent id="End_Oper"/>
        <bpmn:sequenceFlow id="F_o0" sourceRef="Start_Oper" targetRef="G_Entra"/>
        <bpmn:sequenceFlow id="F_o00" sourceRef="G_Entra" targetRef="G_Op"/>
        <bpmn:sequenceFlow id="F_op_cargar" sourceRef="G_Op" targetRef="SP_CargarOp"/>
        <bpmn:sequenceFlow id="F_op_listar" sourceRef="G_Op" targetRef="T_ListarP"/>
        <bpmn:sequenceFlow id="F_op_ganad" sourceRef="G_Op" targetRef="T_ListarG"/>
        <bpmn:sequenceFlow id="F_op_elim" sourceRef="G_Op" targetRef="SP_Eliminar"/>
        <bpmn:sequenceFlow id="F_op_anul" sourceRef="G_Op" targetRef="T_Anular"/>
        <bpmn:sequenceFlow id="F_op_reinic" sourceRef="G_Op" targetRef="SP_Reiniciar"/>
        <bpmn:sequenceFlow id="F_op_corte" sourceRef="G_Op" targetRef="T_Corte"/>
        <bpmn:sequenceFlow id="F_o1" sourceRef="SP_CargarOp" targetRef="G_Unir"/>
        <bpmn:sequenceFlow id="F_o3" sourceRef="T_ListarP" targetRef="G_Unir"/>
        <bpmn:sequenceFlow id="F_o4" sourceRef="T_ListarG" targetRef="G_Unir"/>
        <bpmn:sequenceFlow id="F_o4e" sourceRef="SP_Eliminar" targetRef="G_Unir"/>
        <bpmn:sequenceFlow id="F_o9" sourceRef="T_Anular" targetRef="T_RegAnul"/>
        <bpmn:sequenceFlow id="F_o9b" sourceRef="T_RegAnul" targetRef="G_Unir"/>
        <bpmn:sequenceFlow id="F_o4r" sourceRef="SP_Reiniciar" targetRef="G_Unir"/>
        <bpmn:sequenceFlow id="F_o4b" sourceRef="T_Corte" targetRef="G_Unir"/>
        <bpmn:sequenceFlow id="F_o13" sourceRef="G_Unir" targetRef="G_Mas"/>
        <bpmn:sequenceFlow id="F_mas_si" name="Sí" sourceRef="G_Mas" targetRef="G_Entra"/>
        <bpmn:sequenceFlow id="F_mas_no" name="No" sourceRef="G_Mas" targetRef="End_Oper"/>
      </bpmn:subProcess>
      <bpmn:subProcess id="SP_Sorteo" name="Sorteo general">
        <bpmn:startEvent id="Start_Sorteo"/>
        <bpmn:userTask id="T_Config" name="Configurar el sorteo: grupo, base y cuántos ganadores reales"/>
        <bpmn:exclusiveGateway id="G_Hab" name="¿Habilitar de nuevo a sorteados que no fueron ganador real?"/>
        <bpmn:userTask id="T_Habilitar" name="Marcar a los sorteados que no fueron ganador real y se habilitan en este sorteo"/>
        <bpmn:exclusiveGateway id="G_UneHab"/>
        <bpmn:exclusiveGateway id="G_Alcanza" name="¿Hay suficientes participantes elegibles?"/>
        <bpmn:userTask id="T_Ajustar" name="Ajustar la configuración: número de ganadores, base o grupo"/>
        <bpmn:serviceTask id="T_Seleccionar" name="Sortear a la siguiente persona sin repetir a las ya sorteadas"/>
        <bpmn:userTask id="T_Mostrar" name="Mostrar a la persona sorteada en la pantalla del evento"/>
        <bpmn:userTask id="T_Verificar" name="Verificar si la persona sorteada es ganador real"/>
        <bpmn:exclusiveGateway id="G_Real" name="¿Es ganador real?"/>
        <bpmn:serviceTask id="T_RegReal" name="Registrar al ganador real: orden en el grupo, orden general, hora y nota"/>
        <bpmn:serviceTask id="T_RegNoReal" name="Registrar que no es ganador real: orden, hora y motivo"/>
        <bpmn:exclusiveGateway id="G_Faltan" name="¿Faltan ganadores reales?"/>
        <bpmn:endEvent id="End_Sorteo"/>
        <bpmn:sequenceFlow id="F_n1" sourceRef="Start_Sorteo" targetRef="T_Config"/>
        <bpmn:sequenceFlow id="F_n3" sourceRef="T_Config" targetRef="G_Hab"/>
        <bpmn:sequenceFlow id="F_hab_si" name="Sí" sourceRef="G_Hab" targetRef="T_Habilitar"/>
        <bpmn:sequenceFlow id="F_hab_no" name="No" sourceRef="G_Hab" targetRef="G_UneHab"/>
        <bpmn:sequenceFlow id="F_hab1" sourceRef="T_Habilitar" targetRef="G_UneHab"/>
        <bpmn:sequenceFlow id="F_hab2" sourceRef="G_UneHab" targetRef="G_Alcanza"/>
        <bpmn:sequenceFlow id="F_alc_si" name="Sí" sourceRef="G_Alcanza" targetRef="T_Seleccionar"/>
        <bpmn:sequenceFlow id="F_alc_no" name="No" sourceRef="G_Alcanza" targetRef="T_Ajustar"/>
        <bpmn:sequenceFlow id="F_n4" sourceRef="T_Ajustar" targetRef="T_Config"/>
        <bpmn:sequenceFlow id="F_n5" sourceRef="T_Seleccionar" targetRef="T_Mostrar"/>
        <bpmn:sequenceFlow id="F_n6" sourceRef="T_Mostrar" targetRef="T_Verificar"/>
        <bpmn:sequenceFlow id="F_n7" sourceRef="T_Verificar" targetRef="G_Real"/>
        <bpmn:sequenceFlow id="F_real_si" name="Sí" sourceRef="G_Real" targetRef="T_RegReal"/>
        <bpmn:sequenceFlow id="F_real_no" name="No" sourceRef="G_Real" targetRef="T_RegNoReal"/>
        <bpmn:sequenceFlow id="F_n8" sourceRef="T_RegNoReal" targetRef="T_Seleccionar"/>
        <bpmn:sequenceFlow id="F_n9" sourceRef="T_RegReal" targetRef="G_Faltan"/>
        <bpmn:sequenceFlow id="F_falt_si" name="Sí" sourceRef="G_Faltan" targetRef="T_Seleccionar"/>
        <bpmn:sequenceFlow id="F_falt_no" name="No" sourceRef="G_Faltan" targetRef="End_Sorteo"/>
      </bpmn:subProcess>
      <bpmn:exclusiveGateway id="G_Otra" name="¿Hay otro sorteo?"/>
      <bpmn:endEvent id="End_Sorteos"/>
      <bpmn:sequenceFlow id="F_o1r" sourceRef="Start_Sorteos" targetRef="G_Vuelta"/>
      <bpmn:sequenceFlow id="F_o1v" sourceRef="G_Vuelta" targetRef="G_Oper"/>
      <bpmn:sequenceFlow id="F_oper_si" name="Sí" sourceRef="G_Oper" targetRef="SP_Operar"/>
      <bpmn:sequenceFlow id="F_oper_no" name="No" sourceRef="G_Oper" targetRef="SP_Sorteo"/>
      <bpmn:sequenceFlow id="F_oper_fin" sourceRef="SP_Operar" targetRef="SP_Sorteo"/>
      <bpmn:sequenceFlow id="F_o2r" sourceRef="SP_Sorteo" targetRef="G_Otra"/>
      <bpmn:sequenceFlow id="F_otra_si" name="Sí" sourceRef="G_Otra" targetRef="G_Vuelta"/>
      <bpmn:sequenceFlow id="F_otra_no" name="No" sourceRef="G_Otra" targetRef="End_Sorteos"/>
    </bpmn:subProcess>
    <bpmn:serviceTask id="T_Reporte" name="Generar el reporte de resultados del evento: resumen, ganadores y participantes"/>
    <bpmn:userTask id="T_EntregarReporte" name="Entregar el reporte de resultados al cliente"/>
    <bpmn:endEvent id="End_Evento" name="Evento finalizado"/>
    <bpmn:sequenceFlow id="F_x1" sourceRef="Start_Evento" targetRef="SP_Prep"/>
    <bpmn:sequenceFlow id="F_x2" sourceRef="SP_Prep" targetRef="SP_Sorteos"/>
    <bpmn:sequenceFlow id="F_x3" sourceRef="SP_Sorteos" targetRef="T_Reporte"/>
    <bpmn:sequenceFlow id="F_x4" sourceRef="T_Reporte" targetRef="T_EntregarReporte"/>
    <bpmn:sequenceFlow id="F_x5" sourceRef="T_EntregarReporte" targetRef="End_Evento"/>
  </bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_Process_Evento">
    <bpmndi:BPMNPlane id="Plane_Process_Evento" bpmnElement="Process_Evento">
      <bpmndi:BPMNShape id="Start_Evento_di" bpmnElement="Start_Evento">
        <dc:Bounds x="44" y="67" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_Prep_di" bpmnElement="SP_Prep" isExpanded="false">
        <dc:Bounds x="144" y="39" width="120" height="92"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_Sorteos_di" bpmnElement="SP_Sorteos" isExpanded="false">
        <dc:Bounds x="326" y="209" width="120" height="92"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Reporte_di" bpmnElement="T_Reporte">
        <dc:Bounds x="508" y="379" width="120" height="92"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_EntregarReporte_di" bpmnElement="T_EntregarReporte">
        <dc:Bounds x="690" y="39" width="120" height="92"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Evento_di" bpmnElement="End_Evento">
        <dc:Bounds x="874" y="67" width="36" height="36"/>
      </bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F_x1_di" bpmnElement="F_x1"><di:waypoint x="80" y="85"/><di:waypoint x="144" y="85"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_x2_di" bpmnElement="F_x2"><di:waypoint x="264" y="85"/><di:waypoint x="304" y="85"/><di:waypoint x="304" y="255"/><di:waypoint x="326" y="255"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_x3_di" bpmnElement="F_x3"><di:waypoint x="446" y="255"/><di:waypoint x="486" y="255"/><di:waypoint x="486" y="425"/><di:waypoint x="508" y="425"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_x4_di" bpmnElement="F_x4"><di:waypoint x="628" y="425"/><di:waypoint x="668" y="425"/><di:waypoint x="668" y="85"/><di:waypoint x="690" y="85"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_x5_di" bpmnElement="F_x5"><di:waypoint x="810" y="85"/><di:waypoint x="874" y="85"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram><bpmndi:BPMNDiagram id="Diagram_SP_Prep">
    <bpmndi:BPMNPlane id="Plane_SP_Prep" bpmnElement="SP_Prep">
      <bpmndi:BPMNShape id="Start_Prep_di" bpmnElement="Start_Prep">
        <dc:Bounds x="44" y="67" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Entregar_di" bpmnElement="T_Entregar">
        <dc:Bounds x="144" y="39" width="120" height="92"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_Cargar_di" bpmnElement="SP_Cargar" isExpanded="false">
        <dc:Bounds x="326" y="209" width="120" height="92"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Cargo_di" bpmnElement="G_Cargo" isMarkerVisible="true">
        <dc:Bounds x="508" y="450" width="50" height="50"/>
      <bpmndi:BPMNLabel><dc:Bounds x="485" y="401" width="96" height="46"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_InfNinguno_di" bpmnElement="T_InfNinguno">
        <dc:Bounds x="620" y="361.5" width="120" height="92"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Rech_di" bpmnElement="G_Rech" isMarkerVisible="true">
        <dc:Bounds x="655" y="517.5" width="50" height="50"/>
      <bpmndi:BPMNLabel><dc:Bounds x="632" y="570.5" width="96" height="46"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_InfRech_di" bpmnElement="T_InfRech">
        <dc:Bounds x="802" y="429" width="120" height="92"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Prep_di" bpmnElement="End_Prep">
