      <bpmndi:BPMNShape id="T_Rechazar_di" bpmnElement="T_Rechazar">
        <dc:Bounds x="620" y="45" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Gestion_di" bpmnElement="End_Gestion">
        <dc:Bounds x="662" y="237" width="36" height="36"/>
      </bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F_g1_di" bpmnElement="F_g1"><di:waypoint x="80" y="85"/><di:waypoint x="144" y="85"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_g2_di" bpmnElement="F_g2"><di:waypoint x="264" y="85"/><di:waypoint x="304" y="85"/><di:waypoint x="304" y="255"/><di:waypoint x="326" y="255"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_g3_di" bpmnElement="F_g3"><di:waypoint x="446" y="255"/><di:waypoint x="508" y="255"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_perm_si_di" bpmnElement="F_perm_si"><di:waypoint x="558" y="255"/><di:waypoint x="662" y="255"/><bpmndi:BPMNLabel><dc:Bounds x="566" y="235" width="24" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_perm_no_di" bpmnElement="F_perm_no"><di:waypoint x="533" y="230"/><di:waypoint x="533" y="85"/><di:waypoint x="620" y="85"/><bpmndi:BPMNLabel><dc:Bounds x="503" y="210" width="24" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F_g4_di" bpmnElement="F_g4"><di:waypoint x="680" y="125"/><di:waypoint x="680" y="159"/><di:waypoint x="204" y="159"/><di:waypoint x="204" y="125"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram></bpmn:definitions>